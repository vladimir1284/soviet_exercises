{
  "name": "sovietfit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 execute sovietfit-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute sovietfit-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^4.2.8",
    "svelte-eslint-parser": "^0.43.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.0.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "wrangler": "^4.59.2"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.0.0",
    "svelte-i18n": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}